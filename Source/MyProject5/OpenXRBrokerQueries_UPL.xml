<?xml version="1.0" encoding="utf-8"?>
<root xmlns:android="http://schemas.android.com/apk/res/android">
	<trace enable="true"/>
	<androidManifestUpdates>
		<addElements tag="manifest">
			<queries>
				<provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker"/>
				<intent>
					<action android:name="org.khronos.openxr.OpenXRRuntimeService"/>
				</intent>
				<intent>
					<action android:name="org.khronos.openxr.OpenXRApiLayerService"/>
				</intent>
			</queries>
		</addElements>
		<addAttribute tag="activity" name="android:windowLayoutInDisplayCutoutMode" value="always"/>
	</androidManifestUpdates>

	<gameActivityOnResumeAdditions>
		<insert>
			// Override UE's shortEdges cutout mode with "always" (value 3) to use full display width
			android.view.WindowManager.LayoutParams lp = getWindow().getAttributes();
			lp.layoutInDisplayCutoutMode = 3;
			getWindow().setAttributes(lp);
		</insert>
	</gameActivityOnResumeAdditions>

	<prebuildCopies>
		<copyFile src="$S(PluginDir)/../../Build/Android/src/main/jniLibs/arm64-v8a/libc++_shared.so"
		          dst="$S(BuildDir)/jni/arm64-v8a/libc++_shared.so"/>
	</prebuildCopies>
</root>
